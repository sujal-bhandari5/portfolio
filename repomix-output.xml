.timeline-item p {
  max-width: 620px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.75;
  margin-top: 12px;
}

.dark .timeline-item p,
.dark .timeline-item strong {
  color: #94a3b8;
}


/* =========================================================
   EDUCATION
========================================================= */

.education {
  padding: 70px 20px;
}

.education h2 {
  text-align: center;
  margin-bottom: 55px;
}

.education-timeline {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: start;
}

.education-line {
  position: absolute;
  top: 32px;
  left: 16.66%;
  right: 16.66%;
  height: 2px;
  background: #6bb3ad;
  z-index: 0;
}

.education-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.education-logo {
  width: 65px;
  height: 65px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 12px;
  padding: 5px;
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.education-logo:hover {
  transform: scale(1.08);
}

.education-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 8px;
}

.education-info {
  margin-top: 18px;
  width: 100%;
  padding: 0 15px;
  box-sizing: border-box;
}

.education-info span {
  display: block;
  font-size: 14px;
  opacity: 0.65;
  margin-bottom: 6px;
}

.education-info h3 {
  margin: 0;
  font-size: 18px;
  line-height: 1.3;
}

.education-info p {
  margin: 7px 0 0;
  font-size: 14px;
  opacity: 0.7;
}


/* =========================================================
   CONTACT
========================================================= */

.contact-section {
  background: #172136;
  color: #ffffff;
  padding: 90px 7vw 85px;
}

.contact-container {
  width: min(1100px, 100%);
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 70px;
  align-items: center;
}


/* LEFT */

.section-number {
  display: block;
  margin-bottom: 20px;

  color: #91a4ff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.contact-intro h2 {
  margin: 0;
  max-width: 560px;

  font-size: clamp(44px, 5vw, 68px);
  line-height: 1;
  font-weight: 500;
  letter-spacing: -3px;
}

.contact-intro h2 span {
  display: block;
  color: #9daeff;
}

.contact-intro p {
  max-width: 480px;
  margin: 25px 0 0;

  color: #9aa8bf;
  font-size: 15px;
  line-height: 1.8;
}


/* RIGHT */

.contact-links {
  width: 100%;
}

.social-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}


/* SOCIAL CARD */

.social-card {
  min-width: 0;
  min-height: 72px;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 12px 14px;

  color: #ffffff;
  text-decoration: none;

  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.social-card:hover {
  transform: translateY(-3px);

  background: rgba(255, 255, 255, 0.07);

  border-color: rgba(157, 174, 255, 0.45);
}


/* SOCIAL ICON */

.social-icon {
  width: 42px;
  height: 42px;

  flex: 0 0 42px;

  overflow: hidden;
  border-radius: 9px;

  background: #ffffff;
}

.social-icon img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


/* SOCIAL TEXT */

.social-info {
  min-width: 0;

  display: flex;
  flex-direction: column;
}

.social-info strong {
  font-size: 14px;
  font-weight: 700;
}

.social-info span {
  margin-top: 3px;

  color: #8996ad;
  font-size: 11px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* SOCIAL ARROW */

.social-arrow {
  margin-left: auto;

  color: #91a6ff;
  font-size: 16px;

  transition: transform 0.2s ease;
}

.social-card:hover .social-arrow {
  transform: translate(3px, -3px);
}


/* EMAIL */

.email-card {
  display: flex;
  align-items: center;
  gap: 13px;

  margin-top: 12px;
  padding: 14px;

  color: white;
  text-decoration: none;

  background: rgba(255, 255, 255, 0.035);

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.email-card:hover {
  transform: translateY(-3px);

  background: rgba(255, 255, 255, 0.07);

  border-color: rgba(157, 174, 255, 0.45);
}

.email-icon {
  width: 42px;
  height: 42px;

  flex: 0 0 42px;

  overflow: hidden;
  border-radius: 9px;

  background: white;
}

.email-icon img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}

.email-info {
  min-width: 0;

  display: flex;
  flex-direction: column;
}

.email-info span {
  margin-bottom: 3px;

  color: #8996ad;
  font-size: 11px;
}

.email-info strong {
  font-size: 14px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.email-arrow {
  margin-left: auto;

  color: #91a6ff;
  font-size: 17px;

  transition: transform 0.2s ease;
}

.email-card:hover .email-arrow {
  transform: translate(3px, -3px);
}


/* =========================================================
   FOOTER
========================================================= */

.footer {
  background: #0d1728;
  color: white;

  padding: 38px 7% 22px;
}

.footer-container {
  width: min(1100px, 100%);
  margin: 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 40px;
}

.footer-brand h3 {
  margin: 0 0 6px;

  font-size: 17px;
  font-weight: 750;
  letter-spacing: -0.3px;
}

.footer-brand p {
  margin: 0;

  color: #7f8da5;
  font-size: 12px;
}

.footer-links,
.footer-socials {
  display: flex;
  align-items: center;

  flex-wrap: wrap;

  gap: 22px;
}

.footer-links a,
.footer-socials a {
  color: #8d9ab0;

  text-decoration: none;

  font-size: 12px;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.footer-links a:hover,
.footer-socials a:hover {
  color: #ffffff;
  transform: translateY(-2px);
}

.footer-bottom {
  width: min(1100px, 100%);
  margin: 25px auto 0;

  padding-top: 17px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  border-top: 1px solid rgba(255, 255, 255, 0.07);

  color: #65738a;
  font-size: 11px;
}


/* =========================================================
   ANIMATION
========================================================= */

.reveal {
  animation: reveal 0.7s ease both;
}

@keyframes reveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   FOCUS
========================================================= */

:focus-visible {
  outline: 3px solid #a78bfa;
  outline-offset: 3px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .desktop-nav {
    display: none;
  }

  .desktop-nav.mobile-open {
    display: flex;

    position: absolute;

    top: 68px;
    left: 20px;
    right: 20px;

    flex-direction: column;
    align-items: stretch;

    padding: 10px;

    border: 1px solid #dfe6ee;
    border-radius: 16px;

    background: #fff;

    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
  }

  .dark .desktop-nav.mobile-open {
    background: #111827;
    border-color: #263449;
  }

  .desktop-nav.mobile-open button {
    text-align: left;
  }

  .menu-button {
    display: block;
  }


  /* GENERAL */

  .hero-grid,
  .two-col {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .hero {
    min-height: auto;
    padding-top: 120px;
  }

  .hero-visual {
    min-height: 470px;
  }

  .skill-grid,
  .project-grid {
    grid-template-columns: 1fr 1fr;
  }

  .section-head {
    align-items: start;
    flex-direction: column;
    gap: 10px;
  }


  /* CONTACT */

  .contact-section {
    padding: 75px 6%;
  }

  .contact-container {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .contact-intro h2 {
    max-width: 650px;
  }

  .contact-intro p {
    max-width: 600px;
  }

  .contact-links {
    max-width: 650px;
  }


  /* FOOTER */

  .footer-container {
    align-items: flex-start;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .container {
    width: min(100% - 28px, 1160px);
  }

  .section {
    padding: 80px 0;
  }


  /* NAVBAR */

  .nav-inner {
    min-height: 68px;
  }


  /* HERO */

  .hero h1 {
    font-size: clamp(3rem, 16vw, 5rem);
  }

  .hero-visual {
    min-height: 370px;
  }

  .portrait-wrap {
    width: min(330px, 82vw);
  }

  .glow {
    width: 330px;
    height: 330px;
  }

  .floating-card {
    right: 2%;
    bottom: 10px;
  }


  /* GENERAL */

  .skill-grid,
  .project-grid,
  .info-grid {
    grid-template-columns: 1fr;
  }

  .project-body p {
    min-height: 0;
  }


  /* EDUCATION */

  .education {
    padding: 60px 16px;
  }

  .education-timeline {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .education-line {
    display: none;
  }


  /* CONTACT */

  .contact-section {
    padding: 70px 20px 65px;
  }

  .contact-container {
    width: 100%;
    gap: 38px;
  }

  .section-number {
    margin-bottom: 16px;
    font-size: 11px;
  }

  .contact-intro h2 {
    font-size: clamp(42px, 13vw, 54px);
    line-height: 1;
    letter-spacing: -2.5px;
  }

  .contact-intro p {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.75;
  }

  .contact-links {
    width: 100%;
  }

  .social-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .social-card {
    min-height: 68px;
    padding: 10px;
    gap: 10px;
    border-radius: 11px;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
    border-radius: 8px;
  }

  .social-info strong {
    font-size: 13px;
  }

  .social-info span {
    font-size: 10px;
  }

  .social-arrow {
    display: none;
  }

  .email-card {
    min-height: 66px;

    margin-top: 10px;
    padding: 10px;

    border-radius: 11px;
  }

  .email-icon {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
    border-radius: 8px;
  }

  .email-info strong {
    font-size: 13px;
  }

  .email-arrow {
    display: none;
  }


  /* FOOTER */

  .footer {
    padding: 30px 20px 18px;
  }

  .footer-container {
    width: 100%;

    display: flex;
    flex-direction: column;

    align-items: center;

    gap: 18px;

    text-align: center;
  }

  .footer-brand h3 {
    margin-bottom: 5px;
    font-size: 16px;
  }

  .footer-brand p {
    font-size: 11px;
  }

  .footer-links,
  .footer-socials {
    justify-content: center;
    gap: 18px;
  }

  .footer-links a,
  .footer-socials a {
    font-size: 11px;
  }

  .footer-bottom {
    width: 100%;

    margin-top: 20px;
    padding-top: 14px;

    justify-content: center;

    text-align: center;

    font-size: 10px;
  }
}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

  .contact-section {
    padding-left: 16px;
    padding-right: 16px;
  }

  .contact-intro h2 {
    font-size: 40px;
  }

  .social-grid {
    grid-template-columns: 1fr;
  }

  .social-card {
    min-height: 62px;
  }

  .email-card {
    min-height: 62px;
  }
}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
