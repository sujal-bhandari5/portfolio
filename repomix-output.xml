.dark .portrait-wrap img {
  border-color: #1e293b;
}


/* =========================================================
   FLOATING CARD
========================================================= */

.floating-card {
  position: absolute;
  right: 0;
  bottom: 70px;
  width: 190px;
  padding: 16px;
  border: 1px solid rgba(226, 232, 240, 0.85);
  border-radius: 16px;
