}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {
  position: fixed;
  inset: 0 0 auto;
  z-index: 50;
  transition: 0.25s ease;
}

.navbar-scrolled {
  background: color-mix(in srgb, #f8fafc 84%, transparent);
  backdrop-filter: blur(16px);
  box-shadow: 0 1px 0 rgba(15, 23, 42, 0.07);
}

.dark .navbar-scrolled {
  background: color-mix(in srgb, #0b1120 84%, transparent);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
}

.nav-inner {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  border: 0;
  background: transparent;
  cursor: pointer;
  font-weight: 900;
  font-size: 18px;
  letter-spacing: -0.04em;
}

.brand span {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 13px;
  color: white;
  background: linear-gradient(135deg, #5b67e8, #9b7bf5);
  box-shadow: 0 10px 25px rgba(105, 92, 231, 0.22);
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 4px;
}

.desktop-nav button {
  border: 0;
  background: transparent;
  padding: 10px 12px;
  border-radius: 9px;
  color: #64748b;
  cursor: pointer;
  font-size: 13px;
  font-weight: 650;
}

.desktop-nav button:hover,
.desktop-nav button.active {
  color: #111827;
  background: rgba(100, 116, 139, 0.08);
}

.dark .desktop-nav button:hover,
.dark .desktop-nav button.active {
  color: #f8fafc;
  background: rgba(148, 163, 184, 0.1);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-button,
.menu-button {
  border: 1px solid #e2e8f0;
  background: rgba(255, 255, 255, 0.75);
  color: #334155;
  width: 38px;
  height: 38px;
  border-radius: 11px;
