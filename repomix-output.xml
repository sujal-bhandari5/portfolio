@import "tailwindcss";

:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  color: #172033;
  background: #f8fafc;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #f8fafc;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
}

.dark body,
.dark {
  background: #0b1120;
  color: #e5e7eb;
}

.container {
  width: min(1160px, calc(100% - 40px));
  margin-inline: auto;
}

.section {
  padding: 110px 0;
  scroll-margin-top: 80px;
}

.section-muted {
  background: #f1f5f9;
}

.dark .section-muted {
  background: #0f172a;
}

.section-kicker,
.eyebrow {
  margin: 0 0 16px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #6d5ce7;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h2 {
  margin-bottom: 20px;
  font-size: clamp(2.25rem, 5vw, 4.4rem);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

h2 em {
  color: #64748b;
  font-style: normal;
}

.dark h2 em {
